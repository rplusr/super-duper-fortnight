# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/parcel_tracker?schema=public"

# CORS
CORS_ORIGIN=http://localhost:3001

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Tracking API (AfterShip)
# Get your API key from https://www.aftership.com/
AFTERSHIP_API_KEY=your-aftership-api-key
AFTERSHIP_WEBHOOK_SECRET=your-webhook-secret

# Alternative: Track123 API
# TRACK123_API_KEY=your-track123-api-key

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Webhook URL (for receiving tracking updates)
WEBHOOK_BASE_URL=https://your-domain.com/api/webhooks
